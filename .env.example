# Environment Configuration for Secure Translator
# Notice: NEVER commit actual API keys to source control.
# Confidential documents are strictly processed locally in private storage.

# Server Configuration
PORT=3000
NODE_ENV=development

# Storage Path (Keep outside /public to prevent unauthorized access)
SECURE_STORAGE_PATH=./data/secure_storage

# Data Retention Policy: "delete_immediately" or "persist_until_manual"
DEFAULT_RETENTION_POLICY=delete_immediately

# Translation Provider Options: "airgapped" | "openai" | "gemini" | "local_llm"
DEFAULT_TRANSLATION_PROVIDER=airgapped

# Optional Cloud LLM API Keys (Stored only on server, never exposed to browser)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Local LLM Endpoint (e.g. Ollama or LocalAI)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# Authentication Secret
JWT_SECRET=super-secret-enterprise-key-change-in-production
